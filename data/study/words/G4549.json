{"id":"G4549","lemma":"Σαούλ","transliteration":"saoul","sayIt":"SAOUL","language":"Greek","partOfSpeech":"","gloss":"Saul","meaning":"Σαούλ, ὁ indecl.\n(in FlJ, Σάουλος; Heb. שָׁאוּל)\nSaul;\n(a) the King of Israel: Act.13:21;\n(b) the Jewish name of the Apostle Paul, used in the indecl. form only in address (cf. Σαῦλος): Act.9:4, 17 22:7, 13 26:14.†\n(AS)","glosses":["saul"],"count":6,"occurrences":[{"chapterId":"act-9","v":4,"renderings":{"bsb":"Saul","kjv":"Saul"}},{"chapterId":"act-9","v":17,"renderings":{"bsb":"Saul","kjv":"Saul"}},{"chapterId":"act-13","v":21,"renderings":{"bsb":"Saul","kjv":"Saul"}},{"chapterId":"act-22","v":7,"renderings":{"bsb":"Saul","kjv":"Saul"}},{"chapterId":"act-22","v":13,"renderings":{"bsb":"Saul","kjv":"Saul"}},{"chapterId":"act-26","v":14,"renderings":{"bsb":"Saul","kjv":"Saul"}}],"elsewhere":[{"ref":"Acts 9:4","note":"He fell on the earth, and heard a voice saying to him, “Saul, Saul, why do you persecute me?”","source":"web"}],"related":[{"id":"G4569","lemma":"Σαῦλος","transliteration":"saulos","gloss":"Saul"},{"id":"G3972","lemma":"Παῦλος","transliteration":"paulos","gloss":"Paul"},{"id":"H7586","lemma":"שָׁאוּל","transliteration":"shaul","gloss":"Saul"}],"senses":[{"id":"G4549H","gloss":"Saul","relation":"G4549H = the Greek of"}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}