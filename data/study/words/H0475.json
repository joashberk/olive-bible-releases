{"id":"H0475","lemma":"אֶלְיָשִׁיב","transliteration":"elyashiv","sayIt":"el-ya-SHIV","language":"Hebrew","partOfSpeech":"","gloss":"Eliashib","meaning":"A man of the tribe of Judah living at the time of Divided Monarchy, only mentioned at 1Ch.3.24;\nson of: Elioenai (H0454B);\nbrother of: Hodaviah (H1938), Pelaiah (H6411B), Akkub (H6126), Johanan (H3110I), Delaiah (H1806) and Anani (H6054)\n§ Eliashib = \"God restores\"\n1) a priest in David's reign\n2) a descendant of David\n3) a high priest in Nehemiah's time\n4) a temple singer with foreign wife\n5) one of the line of Zattu\n6) one of the line of Bani","glosses":["eliashib"],"count":15,"occurrences":[{"chapterId":"1ch-3","v":24,"renderings":{"bsb":"Eliashib","kjv":"and Eliashib"}},{"chapterId":"1ch-24","v":12,"renderings":{"bsb":"to Eliashib","kjv":"to Eliashib"}},{"chapterId":"ezr-10","v":6,"renderings":{"bsb":"of Eliashib","kjv":"of Eliashib"}},{"chapterId":"ezr-10","v":24,"renderings":{"bsb":"Eliashib","kjv":"Eliashib"}},{"chapterId":"ezr-10","v":27,"renderings":{"bsb":"Eliashib","kjv":"Eliashib"}},{"chapterId":"ezr-10","v":36,"renderings":{"bsb":"Eliashib"}},{"chapterId":"neh-3","v":1,"renderings":{"bsb":"Eliashib","kjv":"Then Eliashib"}},{"chapterId":"neh-3","v":20,"renderings":{"bsb":"of Eliashib","kjv":"of Eliashib"}},{"chapterId":"neh-3","v":21,"renderings":{"bsb":"of Eliashib","kjv":"of Eliashib"}},{"chapterId":"neh-12","v":10,"renderings":{"bsb":"Eliashib","kjv":"Eliashib"}},{"chapterId":"neh-12","v":22,"renderings":{"bsb":"of Eliashib","kjv":"of Eliashib"}},{"chapterId":"neh-12","v":23,"renderings":{"bsb":"of Eliashib"}},{"chapterId":"neh-13","v":4,"renderings":{"bsb":"Eliashib","kjv":"Eliashib"}},{"chapterId":"neh-13","v":7,"renderings":{"bsb":"Eliashib","kjv":"that Eliashib"}},{"chapterId":"neh-13","v":28,"renderings":{"bsb":"of Eliashib","kjv":"of Eliashib"}}],"elsewhere":[{"ref":"1 Chronicles 3:24","note":"The sons of Elioenai: Hodaviah, Eliashib, Pelaiah, Akkub, Johanan, Delaiah, and Anani, seven