{"id":"G2019","lemma":"ἐπιφωνέω","transliteration":"epiphōneō","sayIt":"epiphōneō","language":"Greek","partOfSpeech":"verb","gloss":"to shout","meaning":"ἐπι-φωνέω, -ῶ\n[in LXX: I Est.9:47 AR, 2Ma.1:23, 3Ma.7:13 * ;]\nto call out, shout: with accusative of thing(s), Act.21:34; with dative of person(s), Act.22:24; before λέγοντες, Luk.23:21; prat. rect., Act.12:22.†\n(AS)","glosses":["kept shouting","began to shout","shouting","outcry"],"count":4,"occurrences":[{"chapterId":"luk-23","v":21,"renderings":{"bsb":"they kept shouting","kjv":"they cried"}},{"chapterId":"act-12","v":22,"renderings":{"bsb":"began to shout","kjv":"gave a shout"}},{"chapterId":"act-21","v":34,"renderings":{"bsb":"were shouting"}},{"chapterId":"act-22","v":24,"renderings":{"bsb":"outcry","kjv":"they cried"}}],"elsewhere":[{"ref":"Luke 23:21","note":"but they shouted, saying, “Crucify! Crucify him!”","source":"web"},{"ref":"Acts 12:22","note":"The people shouted, “The voice of a god, and not of a man!”","source":"web"}],"related":[{"id":"G20190","lemma":"γαλακτοτροφέω","transliteration":"galaktotropheō","gloss":"to give milk"},{"id":"G20191","lemma":"γαλακτοτροφία","transliteration":"galaktotrophia","gloss":"to suckle"},{"id":"G20192","lemma":"γενεσιάρχης","transliteration":"genesiarchēs","gloss":"creator"},{"id":"G20193","lemma":"γενεσιουργός","transliteration":"genesiourgos","gloss":"fashioner, creator"},{"id":"G20195","lemma":"γῆρος","transliteration":"gēros","gloss":"old age"},{"id":"G20197","lemma":"γλωσσοκομεῖον","transliteration":"glōssokomeion","gloss":"coffin"},{"id":"G20198","lemma":"γνωριστής","transliteration":"gnōristēs","gloss":"diviner"},{"id":"G20199","lemma":"γονορρυέω","transliteration":"gonorrueō","gloss":"be subject to spermatorrhoea"}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}