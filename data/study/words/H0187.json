{"id":"H0187","lemma":"אוּזָל","transliteration":"uzal","sayIt":"u-ZAL","language":"Hebrew","partOfSpeech":"","gloss":"Uzal","meaning":"A man living at the time of the Patriarchs, first mentioned at Gen.10.27;\nson of: Joktan (H3355);\nbrother of: Almodad (H0486), Sheleph (H8026), Hazarmaveth (H2700), Jerah (H3392), Hadoram (H1913A), Diklah (H1853), Obal (H5745), Abimael (H0039), Sheba (H7614H), Ophir (H0211), Havilah (H2341I) and Jobab (H3103)\n§ Uzal = \"I shall be flooded\"\nsixth son Joktan","glosses":["uzal","izal"],"count":3,"occurrences":[{"chapterId":"gen-10","v":27,"renderings":{"bsb":"Uzal","kjv":"and Uzal"}},{"chapterId":"1ch-1","v":21,"renderings":{"bsb":"Uzal","kjv":"and Uzal"}},{"chapterId":"ezk-27","v":19,"renderings":{"bsb":"from Izal"}}],"elsewhere":[{"ref":"Genesis 10:27","note":"Hadoram, Uzal, Diklah,","source":"web"},{"ref":"1 Chronicles 1:21","note":"Hadoram, Uzal, Diklah,","source":"web"},{"ref":"Ezekiel 27:19","note":"“ ‘ “Vedan and Javan traded with yarn for your wares: bright iron, cassia, and calamus were among your merchandise.","source":"web"}],"related":[{"id":"H0039","lemma":"אֲבִימָאֵל","transliteration":"avimael","gloss":"Abimael"},{"id":"H3355","lemma":"יׇקְטָן","transliteration":"yoqtan","gloss":"Joktan"},{"id":"H0486","lemma":"אַלְמוֹדָד","transliteration":"almodad","gloss":"Almodad"},{"id":"H8026","lemma":"שֶׁ֫לֶף","transliteration":"sheleph","gloss":"Sheleph"},{"id":"H2700","lemma":"חֲצַרְמָ֫וֶת","transliteration":"chatsarmavet","gloss":"Hazarmaveth"},{"id":"H3392","lemma":"יֶ֫רַח","transliteration":"yerach","gloss":"Jerah"},{"id":"H1913","lemma":"הֲדוֹרָם","transliteration":"hadoram","gloss":"Hadoram"},{"id":"H1853","lemma":"דִּקְלָה","transliteration":"diqlah","gloss":"Diklah"}],"senses":[{"id":"H0187H","gloss":"Uzal","relation":"H0187H ="}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}