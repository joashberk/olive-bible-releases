iah 26:18","note":"“Micah the Morashtite prophesied in the days of Hezekiah king of Judah; and he spoke to all the people of Judah, saying, ‘Yahweh of Armies says: “ ‘Zion will…","source":"web"},{"ref":"Micah 1:1","note":"Yahweh’s word that came to Micah the Morashtite in the days of Jotham, Ahaz, and Hezekiah, kings of Judah, which he saw concerning Samaria and Jerusalem.","source":"web"}],"related":[{"id":"H4316","lemma":"מִיכָא","transliteration":"mikah","gloss":"Mica"},{"id":"H4320","lemma":"מִיכָיָה","transliteration":"mikhayah","gloss":"Micaiah"},{"id":"H4321","lemma":"מִיכָֽיְהוּ","transliteration":"mikhayehu","gloss":"Micaiah"},{"id":"H0271","lemma":"אָחָז","transliteration":"achaz","gloss":"Ahaz"},{"id":"H0469","lemma":"אֱלִיצָפָן","transliteration":"elitsaphan","gloss":"Elizaphan"},{"id":"H3449","lemma":"יִשִּׁיָּהוּ","transliteration":"yishshiyyah","gloss":"Isshiah"},{"id":"H4648","lemma":"מְפִיבֹשֶׁת","transliteration":"mephivoshet","gloss":"Mephibosheth"},{"id":"H6377","lemma":"פִּיתוֹן","transliteration":"piton","gloss":"Pithon"}],"senses":[{"id":"H4318H","gloss":"Micah","relation":"H4318H ="},{"id":"H4318I","gloss":"Micah","relation":"H4318I ="},{"id":"H4318J","gloss":"Micah","relation":"H4318J ="},{"id":"H4318K","gloss":"Micah","relation":"H4318K ="},{"id":"H4318L","gloss":"Mica","relation":"H4318L = a Name of"},{"id":"H4318M","gloss":"Micah","relation":"H4318M = a Name of"},{"id":"H4318N","gloss":"Micaiah","relation":"H4318N = a Name of"}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}