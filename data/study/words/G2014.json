{"id":"G2014","lemma":"ἐπιφαίνω","transliteration":"epiphainō","sayIt":"epiphainō","language":"Greek","partOfSpeech":"verb","gloss":"to appear","meaning":"ἐπι-φαίνω\n[in LXX for עוּר hi., etc. ;]\n1. to show forth.\n2. (= pass. in cl.) to appear: Act.27:20; with dative of person(s), Luk.1:79; metaphorically, Tit.3:4; with dative, Tit.2:11 (Cremer, 567).†\n(AS)","glosses":["appeared","shine on","has appeared"],"count":4,"occurrences":[{"chapterId":"luk-1","v":79,"renderings":{"bsb":"to shine on","kjv":"To give light"}},{"chapterId":"act-27","v":20,"renderings":{"bsb":"appeared","kjv":"appeared"}},{"chapterId":"tit-2","v":11,"renderings":{"bsb":"has appeared","kjv":"hath appeared"}},{"chapterId":"tit-3","v":4,"renderings":{"bsb":"appeared"}}],"elsewhere":[{"ref":"Luke 1:79","note":"to shine on those who sit in darkness and the shadow of death; to guide our feet into the way of peace.”","source":"web"},{"ref":"Acts 27:20","note":"When neither sun nor stars shone on us for many days, and no small storm pressed on us, all hope that we would be saved was now taken away.","source":"web"},{"ref":"Titus 2:11","note":"For the grace of God has appeared, bringing salvation to all men,","source":"web"}],"related":[{"id":"G20140","lemma":"ἄρκος","transliteration":"arkos","gloss":"bear"},{"id":"G20141","lemma":"ἁρμόνιος","transliteration":"harmonios","gloss":"fitting, harmonious"},{"id":"G20143","lemma":"ἀροτριόω","transliteration":"arotrioō","gloss":"be ploughed"},{"id":"G20144","lemma":"ἀρραβωνίζεται","transliteration":"arrabōnizetai","gloss":"deposit paid"},{"id":"G20145","lemma":"ἀρρενώδης","transliteration":"arrenōdēs","gloss":"brave."},{"id":"G20146","lemma":"ἄρσην","transliteration":"arsēn","gloss":"aršan-"},{"id":"G20147","lemma":"ἀρχιεράομαι","transliteration":"archieraomai","gloss":"priestess"},{"id":"G20148","lemma":"ἀρχιερατεύω","transliteration":"archierateuō","gloss":"be high-priest"}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}