{"id":"H1361","lemma":"גָּבַהּ","transliteration":"gavah","sayIt":"ga-VAH","language":"Hebrew","partOfSpeech":"verb","gloss":"to exult","meaning":"1) to be high, be exalted\n1a) (Qal)\n1a1) to be high, lofty, tall\n1a2) to be exalted\n1a3) to be lofty\n1a3a) to be lofty (of Jehovah's ways-good sense)\n1a3b) to be haughty, be arrogant (bad sense)\n1b) (Hiphil) to make high, exalt","glosses":["proud","high","soar","haughty","exalted","taller"],"count":33,"occurrences":[{"chapterId":"1sa-10","v":23,"renderings":{"bsb":"taller","kjv":"he was higher"}},{"chapterId":"2ch-17","v":6,"renderings":{"bsb":"took delight","kjv":"was lifted up"}},{"chapterId":"2ch-26","v":16,"renderings":{"bsb":"his arrogance","kjv":"was lifted up"}},{"chapterId":"2ch-32","v":25,"renderings":{"bsb":"was proud","kjv":"was lifted up"}},{"chapterId":"2ch-33","v":14,"renderings":{"bsb":"and heightened it","kjv":"and raised it up"}},{"chapterId":"job-5","v":7,"renderings":{"bsb":"upward"}},{"chapterId":"job-35","v":5,"renderings":{"bsb":"high"}},{"chapterId":"job-36","v":7,"renderings":{"bsb":"and exalts them"}},{"chapterId":"job-39","v":27,"renderings":{"bsb":"soar","kjv":"mount up"}},{"chapterId":"psa-103","v":11,"renderings":{"bsb":"as high","kjv":"is high above"}},{"chapterId":"psa-113","v":5,"renderings":{"bsb":"on high"}},{"chapterId":"psa-131","v":1,"renderings":{"bsb":"proud","kjv":"is not haughty"}},{"chapterId":"pro-17","v":19,"renderings":{"bsb":"high","kjv":"and he that exalteth"}},{"chapterId":"pro-18","v":12,"renderings":{"bsb":"is proud","kjv":"is haughty"}},{"chapterId":"isa-3","v":16,"renderings":{"bsb":"are haughty","kjv":"are haughty"}},{"chapterId":"isa-5","v":16,"renderings":{"bsb":"will be exalted","kjv":"shall be exalted"}},{"chapterId":"isa-7","v":11,"renderings":{"bsb":"the heights","kjv":"or in the height"}},{"chapterId":"isa-52","v":13,"renderings":{"bsb":"exalted"}},{"chapterId":"isa-55","v":9,"renderings":{"bsb":"are higher","kjv":"are higher"}},{"chapterId":"jer-13","v":1