{"id":"H4268","lemma":"מַחְסֶּה","transliteration":"machaseh","sayIt":"ma-cha-seh","language":"Hebrew","partOfSpeech":"noun, masculine","gloss":"refuge","meaning":"1) refuge, shelter\n1a) from rain or storm, from danger\n1b) of falsehood","glosses":["refuge","shelter","place of refuge","refuge from"],"count":20,"occurrences":[{"chapterId":"job-24","v":8,"renderings":{"bsb":"of shelter"}},{"chapterId":"psa-14","v":6,"renderings":{"bsb":"is their shelter"}},{"chapterId":"psa-46","v":1,"renderings":{"bsb":"refuge","kjv":"is our refuge"}},{"chapterId":"psa-61","v":3,"renderings":{"bsb":"my refuge","kjv":"For thou hast been a shelter"}},{"chapterId":"psa-62","v":7,"renderings":{"bsb":"my refuge","kjv":"and my refuge"}},{"chapterId":"psa-62","v":8,"renderings":{"bsb":"is our refuge","kjv":"is a refuge"}},{"chapterId":"psa-71","v":7,"renderings":{"bsb":"refuge"}},{"chapterId":"psa-73","v":28,"renderings":{"bsb":"my refuge","kjv":"my trust"}},{"chapterId":"psa-91","v":2,"renderings":{"bsb":"You are my refuge","kjv":"He is my refuge"}},{"chapterId":"psa-91","v":9,"renderings":{"bsb":"my refuge","kjv":"which is my refuge"}},{"chapterId":"psa-94","v":22,"renderings":{"bsb":"of refuge"}},{"chapterId":"psa-104","v":18,"renderings":{"bsb":"a refuge","kjv":"are a refuge"}},{"chapterId":"psa-142","v":5,"renderings":{"bsb":"are my refuge","kjv":"Thou art my refuge"}},{"chapterId":"pro-14","v":26,"renderings":{"bsb":"a place of refuge"}},{"chapterId":"isa-4","v":6,"renderings":{"bsb":"and a refuge","kjv":"and for a place of refuge"}},{"chapterId":"isa-25","v":4,"renderings":{"bsb":"refuge from","kjv":"a refuge"}},{"chapterId":"isa-28","v":15,"renderings":{"bsb":"our refuge","kjv":"our refuge"}},{"chapterId":"isa-28","v":17,"renderings":{"bsb":"your refuge","kjv":"the refuge"}},{"chapterId":"jer-17","v":17,"renderings":{"bsb":"are my refuge","kjv":"thou art my hope"}},{"chapterId":"jol-3","v":16,"renderings":{"bsb":"will be a refuge","kjv":"will be the hope"}}],"elsewhere":[{"ref":"Job 24:8","note":"They are wet with the showers of the mountains, and embrace the rock for lack of a shelter.","source":"web"},{"ref":"Psalm 14:6","note":"You frustrate the plan of the poor, because Yahweh is his refuge.","source":"web"},{"ref":"Proverbs 14:26","note":"In the fear of Yahweh is a secure fortress, and he will be a refuge for his children.","source":"web"},{"ref":"Isaiah 4:6","note":"There will be a pavilion for a shade in the daytime from the heat, and for a refuge and for a shelter from storm and from rain.","source":"web"},{"ref":"Jeremiah 17:17","note":"Don’t be a terror to me. You are my refuge in the day of evil.","source":"web"},{"ref":"Joel 3:16","note":"Yahweh will roar from Zion, and thunder from Jerusalem; and the heavens and the earth will shake; but Yahweh will be a refuge to his people, and a stronghold…","source":"web"}],"related":[],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}