{"id":"G2114","lemma":"εὐθυμέω","transliteration":"euthumeō","sayIt":"euthumeō","language":"Greek","partOfSpeech":"verb","gloss":"be cheerful","meaning":"εὐθυμέω, -ῶ\n(ὔθυμος), [in Sm.: Psa.32:11, Pro.15:15 * ;]\n1. trans., to make cheerful (Æsch.).\n2. Intrans. (Eur., Plut.; so mid. in Xen., Plat.), to be of good cheer: Act.27:22, 25, Jas.5:13.†\n(AS)","glosses":["keep up your courage","take courage","cheerful"],"count":3,"occurrences":[{"chapterId":"act-27","v":22,"renderings":{"bsb":"to keep up your courage","kjv":"to be of good cheer"}},{"chapterId":"act-27","v":25,"renderings":{"bsb":"take courage","kjv":"be of good cheer"}},{"chapterId":"jas-5","v":13,"renderings":{"bsb":"cheerful","kjv":"Is"}}],"elsewhere":[{"ref":"Acts 27:22","note":"Now I exhort you to cheer up, for there will be no loss of life among you, but only of the ship.","source":"web"},{"ref":"James 5:13","note":"Is any among you suffering? Let him pray. Is any cheerful? Let him sing praises.","source":"web"}],"related":[{"id":"G21140","lemma":"στραγγεύομαι","transliteration":"strangeuomai","gloss":"agino"},{"id":"G21141","lemma":"στρατηγέω","transliteration":"stratēgeō","gloss":"be general"},{"id":"G21142","lemma":"στρατηγία","transliteration":"stratēgia","gloss":"province governed by a"},{"id":"G21143","lemma":"στρέβλη","transliteration":"streblē","gloss":"torture"},{"id":"G21144","lemma":"στρεβλωτήριος","transliteration":"streblōtērios","gloss":"rack"},{"id":"G21145","lemma":"στρυφαλίς","transliteration":"struphalis","gloss":"cheese"},{"id":"G21146","lemma":"στρύχνον","transliteration":"struchnon","gloss":"winter cherry"},{"id":"G21147","lemma":"συγγελάω","transliteration":"sungelaō","gloss":"to laugh with"}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}