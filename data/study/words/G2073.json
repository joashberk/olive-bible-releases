{"id":"G2073","lemma":"ἑσπέρα","transliteration":"hespera","sayIt":"hespera","language":"Greek","partOfSpeech":"noun, feminine","gloss":"evening","meaning":"ἑσπέρα, -ας, ἡ\n(prop, fem, of ἕσπερος), [in LXX chiefly for עָרַב ;]\n(a) (sc. ὥρα), evening: Luk.24:29, Act.4:3 20:15 28:23;\n(b) (so. χώρα), the west.†\n(AS)","glosses":["evening"],"count":3,"occurrences":[{"chapterId":"luk-24","v":29,"renderings":{"bsb":"evening","kjv":"evening"}},{"chapterId":"act-4","v":3,"renderings":{"bsb":"evening"}},{"chapterId":"act-28","v":23,"renderings":{"bsb":"evening"}}],"elsewhere":[{"ref":"Luke 24:29","note":"They urged him, saying, “Stay with us, for it is almost evening, and the day is almost over.” He went in to stay with them.","source":"web"},{"ref":"Acts 4:3","note":"They laid hands on them, and put them in custody until the next day, for it was now evening.","source":"web"}],"related":[{"id":"G20731","lemma":"μηνιτής","transliteration":"mēnitēs","gloss":"wrathful man"},{"id":"G20732","lemma":"μὴπολλάκις","transliteration":"mēpollakis","gloss":"lest perchance"},{"id":"G20733","lemma":"μηροραφής","transliteration":"mēroraphēs","gloss":"thigh-burnt"},{"id":"G20734","lemma":"μηρυκίζω","transliteration":"mērukizō","gloss":"to chew the cud"},{"id":"G20735","lemma":"μηχανάριος","transliteration":"mēchanarios","gloss":"engineer"},{"id":"G20736","lemma":"μιαροφαγέω","transliteration":"miarophageō","gloss":"to eat abominable food"},{"id":"G20737","lemma":"Μιμνέρμειον","transliteration":"mimnermeion","gloss":"gymnasium named after Mimnermus"},{"id":"G20738","lemma":"μισάρετος","transliteration":"misaretos","gloss":"hating virtue"}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}