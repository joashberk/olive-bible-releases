{"id":"G2001","lemma":"ἐπισχύω","transliteration":"epischuō","sayIt":"epischuō","language":"Greek","partOfSpeech":"verb","gloss":"to insist","meaning":"ἐπ-ισχύω\n[in LXX: Sir.29:1, 1Ma.6:6 * ;]\n1. to make stronger (Sir, l.with).\n2. to grow stronger; metaphorically, be more urgent: Luk.23:5.†\n(AS)","glosses":["kept insisting"],"count":1,"occurrences":[{"chapterId":"luk-23","v":5,"renderings":{"bsb":"they kept insisting","kjv":"they were the more fierce"}}],"elsewhere":[{"ref":"Luke 23:5","note":"But they insisted, saying, “He stirs up the people, teaching throughout all Judea, beginning from Galilee even to this place.”","source":"web"}],"related":[{"id":"G20010","lemma":"ἁγιοποιέω","transliteration":"hagiopoieō","gloss":"to sanctify"},{"id":"G20011","lemma":"ἁγιστεία","transliteration":"hagisteia","gloss":"service"},{"id":"G20013","lemma":"ἁγνιασμός","transliteration":"hagniasmos","gloss":"purification"},{"id":"G20014","lemma":"ἄγυια","transliteration":"aguia","gloss":"city"},{"id":"G20015","lemma":"ἀγύναιξ","transliteration":"agunaix","gloss":"wifeless"},{"id":"G20016","lemma":"ἀδελφικός","transliteration":"adelphikos","gloss":"sisterly"},{"id":"G20017","lemma":"ἀδελφοπρεπῶς","transliteration":"adelphoprepōs","gloss":"as befits a brother"},{"id":"G20018","lemma":"ἀδιάστροφος","transliteration":"adiastrophos","gloss":"without molestation"}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}