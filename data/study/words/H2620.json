{"id":"H2620","lemma":"חָסָה","transliteration":"chasah","sayIt":"cha-sah","language":"Hebrew","partOfSpeech":"verb","gloss":"to seek refuge","meaning":"1) (Qal) to seek refuge, flee for protection\n1a) to put trust in (God), confide or hope in (God) (fig.)","glosses":["take refuge","who take refuge","find refuge","whom i take refuge","have taken refuge","took refuge"],"count":36,"occurrences":[{"chapterId":"deu-32","v":37,"renderings":{"bsb":"took refuge"}},{"chapterId":"jdg-9","v":15,"renderings":{"bsb":"and find refuge","kjv":"and put your trust"}},{"chapterId":"rut-2","v":12,"renderings":{"bsb":"refuge"}},{"chapterId":"2sa-22","v":3,"renderings":{"bsb":"in whom I take refuge","kjv":"in him will I trust"}},{"chapterId":"2sa-22","v":31,"renderings":{"bsb":"who take refuge","kjv":"to all them that trust"}},{"chapterId":"psa-2","v":12,"renderings":{"bsb":"who take refuge"}},{"chapterId":"psa-5","v":11,"renderings":{"bsb":"who take refuge","kjv":"But let all those that put their trust"}},{"chapterId":"psa-7","v":1,"renderings":{"bsb":"I take refuge","kjv":"in thee do I put my trust"}},{"chapterId":"psa-11","v":1,"renderings":{"bsb":"I take refuge","kjv":"put I my trust"}},{"chapterId":"psa-16","v":1,"renderings":{"bsb":"I take refuge"}},{"chapterId":"psa-17","v":7,"renderings":{"bsb":"those who seek refuge","kjv":"them which put their trust"}},{"chapterId":"psa-18","v":2,"renderings":{"bsb":"in whom I take refuge","kjv":"in whom I will trust"}},{"chapterId":"psa-18","v":30,"renderings":{"bsb":"who take refuge"}},{"chapterId":"psa-25","v":20,"renderings":{"bsb":"I take refuge"}},{"chapterId":"psa-31","v":1,"renderings":{"bsb":"I have taken refuge","kjv":"do I put my trust"}},{"chapterId":"psa-31","v":19,"renderings":{"bsb":"on those who take refuge","kjv":"for them that trust"}},{"chapterId":"psa-34","v":8,"renderings":{"bsb":"who takes refuge"}},{"chapterId":"psa-34","v":22,"renderings":{"bsb":"who take refuge","kjv":"and none of them that trust"}},{"chapterId":"psa-