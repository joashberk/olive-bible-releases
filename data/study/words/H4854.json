{"id":"H4854","lemma":"מַשָּׂא","transliteration":"massa","sayIt":"mas-SA","language":"Hebrew","partOfSpeech":"","gloss":"Massa","meaning":"A man of the Arabs living at the time of the Patriarchs, first mentioned at Gen.25.14;\nson of: Ishmael (H3458);\nbrother of: Nebaioth (H5032), Kedar (H6938), Adbeel (H0110), Mibsam (H4017), Mishma (H4927), Dumah (H1746), Hadad (H2301), Tema (H8485), Jetur (H3195), Naphish (H5305), Kedemah (H6929) and Mahalath (H4258)\n§ Massa = \"burden\"\na son of Ishmael","glosses":["massa"],"count":2,"occurrences":[{"chapterId":"gen-25","v":14,"renderings":{"bsb":"Massa"}},{"chapterId":"1ch-1","v":30,"renderings":{"bsb":"Massa","kjv":"Massa"}}],"elsewhere":[{"ref":"Genesis 25:14","note":"Mishma, Dumah, Massa,","source":"web"},{"ref":"1 Chronicles 1:30","note":"Mishma, Dumah, Massa, Hadad, Tema,","source":"web"}],"related":[{"id":"H0110","lemma":"אַדְבְּאֵל","transliteration":"adbeel","gloss":"Adbeel"},{"id":"H1746","lemma":"דּוּמָה","transliteration":"dumah","gloss":"Dumah"},{"id":"H2301","lemma":"חֲדַד","transliteration":"chadad","gloss":"Hadad"},{"id":"H3195","lemma":"יְטוּר","transliteration":"yetur","gloss":"Jetur"},{"id":"H3458","lemma":"יִשְׁמָעֵאל","transliteration":"yishmael","gloss":"Ishmael"},{"id":"H4017","lemma":"מִבְשָׂם","transliteration":"mivsam","gloss":"Mibsam"},{"id":"H4258","lemma":"מַחֲלַת","transliteration":"machalat","gloss":"Mahalath"},{"id":"H5032","lemma":"נְבָיוֹת","transliteration":"nevavot","gloss":"Nebaioth"}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}