{"id":"H4111","lemma":"מַהֲלַלְאֵל","transliteration":"mahalalel","sayIt":"MA-ha-lal-el","language":"Hebrew","partOfSpeech":"","gloss":"Mahalalel","meaning":"A man living at the time before the Flood, first mentioned at Gen.5.12;\nson of: Kenan (H7018);\nfather of: Jared (H3382); also called Mahalaleel (NIV: Mahalel) at Luk.3.37;\nAlso named: Maleleēl (Μαλελεήλ \"Mahalaleel\" G3121)\n§ Mahalaleel = \"praise of God\"\n1) son of Cainan and the 4th in descent from Adam in the line of Seth\n2) a descendant of Perez, the son of Judah","glosses":["mahalalel","when mahalalel","so mahalalel"],"count":7,"occurrences":[{"chapterId":"gen-5","v":12,"renderings":{"bsb":"Mahalalel"}},{"chapterId":"gen-5","v":13,"renderings":{"bsb":"Mahalalel","kjv":"Mahalaleel"}},{"chapterId":"gen-5","v":15,"renderings":{"bsb":"When Mahalalel","kjv":"And Mahalaleel"}},{"chapterId":"gen-5","v":16,"renderings":{"bsb":"Mahalalel","kjv":"And Mahalaleel"}},{"chapterId":"gen-5","v":17,"renderings":{"bsb":"So Mahalalel","kjv":"of Mahalaleel"}},{"chapterId":"1ch-1","v":2,"renderings":{"bsb":"Mahalalel","kjv":"Mahalaleel"}},{"chapterId":"neh-11","v":4,"renderings":{"bsb":"of Mahalalel","kjv":"of Mahalaleel"}}],"elsewhere":[{"ref":"Genesis 5:12","note":"Kenan lived seventy years, then became the father of Mahalalel.","source":"web"},{"ref":"1 Chronicles 1:2","note":"Kenan, Mahalalel, Jared,","source":"web"},{"ref":"Nehemiah 11:4","note":"Some of the children of Judah and of the children of Benjamin lived in Jerusalem. Of the children of Judah: Athaiah the son of Uzziah, the son of Zechariah…","source":"web"}],"related":[{"id":"H3382","lemma":"יֶ֫רֶד","transliteration":"yered","gloss":"Jared"},{"id":"H7018","lemma":"קֵינָן","transliteration":"qenan","gloss":"Kenan"},{"id":"G3121","lemma":"Μαλελεήλ","transliteration":"maleleēl","gloss":"Mahalaleel"},{"id":"H8203","lemma":"שְׁפַטְיָהוּ","transliteration":"shephatyah","gloss":"Shephatiah"}],"senses":[{"id":"H4111H","gloss":"Mahalalel","relation":"H4111H ="}],"