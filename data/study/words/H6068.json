{"id":"H6068","lemma":"עֲנָתוֹת","transliteration":"anatot","sayIt":"a-na-TOT","language":"Hebrew","partOfSpeech":"","gloss":"Anathoth","meaning":"Anathoth = \"answers to prayer\"\na city of Benjamin allotted to the priest; located approximately 3 miles (5 km) from Jerusalem; birthplace of the prophet Jeremiah\nAlso named: an.to.ti (עַנְּתֹתִי \"Anathoth\" H6069)","glosses":["anathoth","anathoth in"],"count":15,"occurrences":[{"chapterId":"jos-21","v":18,"renderings":{"bsb":"Anathoth","kjv":"Anathoth"}},{"chapterId":"1ki-2","v":26,"renderings":{"bsb":"in Anathoth","kjv":"thee to Anathoth"}},{"chapterId":"1ch-6","v":60,"renderings":{"bsb":"and Anathoth","kjv":"and Anathoth"}},{"chapterId":"1ch-7","v":8,"renderings":{"bsb":"Anathoth","kjv":"and Anathoth"}},{"chapterId":"ezr-2","v":23,"renderings":{"bsb":"of Anathoth","kjv":"of Anathoth"}},{"chapterId":"neh-7","v":27,"renderings":{"bsb":"of Anathoth","kjv":"of Anathoth"}},{"chapterId":"neh-10","v":19,"renderings":{"bsb":"Anathoth","kjv":"Anathoth"}},{"chapterId":"neh-11","v":32,"renderings":{"bsb":"in Anathoth","kjv":"And at Anathoth"}},{"chapterId":"isa-10","v":30,"renderings":{"bsb":"Anathoth"}},{"chapterId":"jer-1","v":1,"renderings":{"bsb":"in Anathoth","kjv":"that were in Anathoth"}},{"chapterId":"jer-11","v":21,"renderings":{"bsb":"of Anathoth","kjv":"of Anathoth"}},{"chapterId":"jer-11","v":23,"renderings":{"bsb":"Anathoth in","kjv":"of Anathoth"}},{"chapterId":"jer-32","v":7,"renderings":{"bsb":"in Anathoth","kjv":"that is in Anathoth"}},{"chapterId":"jer-32","v":8,"renderings":{"bsb":"in Anathoth","kjv":"that is in Anathoth"}},{"chapterId":"jer-32","v":9,"renderings":{"bsb":"in Anathoth","kjv":"that was in Anathoth"}}],"elsewhere":[{"ref":"Joshua 21:18","note":"Anathoth with its pasture lands, and Almon with its pasture lands: four cities.","source":"web"},{"ref":"1 Kings 2:26","note":"To Abiathar the priest the king said, “Go to Anathoth, to your own fields; for you are worthy of death. But I will not at this time put you to death, because…","source":"web"},{"ref":"1 Chronicles 6:60","note":"and out of the tribe of Benjamin, Geba with its pasture lands, Allemeth with its pasture lands, and Anathoth with its pasture lands. All their cities…","source":"web"},{"ref":"Ezra 2:23","note":"The men of Anathoth, one hundred twenty-eight.","source":"web"},{"ref":"Nehemiah 7:27","note":"The men of Anathoth: one hundred twenty-eight.","source":"web"},{"ref":"Isaiah 10:30","note":"Cry aloud with your voice, daughter of Gallim! Listen, Laishah! You poor Anathoth!","source":"web"},{"ref":"Jeremiah 1:1","note":"The words of Jeremiah the son of Hilkiah, one of the priests who were in Anathoth in the land of Benjamin.","source":"web"}],"related":[{"id":"H6069","lemma":"עַנְּתֹתִי","transliteration":"antoti","gloss":"Anathoth"},{"id":"H0029","lemma":"אֲבִיָּה","transliteration":"aviyyah","gloss":"Abijah"},{"id":"H0454","lemma":"אֶלְיְהוֹעֵינַי","transliteration":"elyehoenay","gloss":"Eliehoenai"},{"id":"H0461","lemma":"אֱלִיעֶ֫זֶר","transliteration":"eliezer","gloss":"Eliezer"},{"id":"H1071","lemma":"בֶּ֫כֶר","transliteration":"bekher","gloss":"Becher"},{"id":"H2160","lemma":"זְמִירָה","transliteration":"zemirah","gloss":"Zemirah"},{"id":"H3135","lemma":"יוֹעָשׁ","transliteration":"yoash","gloss":"Joash"},{"id":"H3406","lemma":"יְרִימוֹת","transliteration":"yerimot","gloss":"Jerimoth"}],"senses":[{"id":"H6068H","gloss":"Anathoth","relation":"H6068H ="},{"id":"H6068I","gloss":"Anathoth","relation":"H6068I ="}],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}