{"id":"H5290","lemma":"נֹ֫עַר","transliteration":"noar","sayIt":"no-ar","language":"Hebrew","partOfSpeech":"noun, masculine","gloss":"youth","meaning":"youth, boyhood, early life","glosses":["youth","child’s"],"count":4,"occurrences":[{"chapterId":"job-33","v":25,"renderings":{"bsb":"like a child’s","kjv":"than a child's"}},{"chapterId":"job-36","v":14,"renderings":{"bsb":"in their youth","kjv":"in youth"}},{"chapterId":"psa-88","v":15,"renderings":{"bsb":"From my youth","kjv":"from my youth"}},{"chapterId":"pro-29","v":21,"renderings":{"bsb":"from his youth","kjv":"from a child"}}],"elsewhere":[{"ref":"Job 33:25","note":"His flesh will be fresher than a child’s. He returns to the days of his youth.","source":"web"},{"ref":"Psalm 88:15","note":"I am afflicted and ready to die from my youth up. While I suffer your terrors, I am distracted.","source":"web"},{"ref":"Proverbs 29:21","note":"He who pampers his servant from youth will have him become a son in the end.","source":"web"}],"related":[],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}