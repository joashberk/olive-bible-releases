{"id":"H8630","lemma":"תָּקֵף","transliteration":"taqaph","sayIt":"ta-qaph","language":"Hebrew","partOfSpeech":"verb","gloss":"to prevail","meaning":"(Qal) to prevail over or against, overcome, overpower","glosses":["overpower him","overwhelming him","may be overpowered"],"count":3,"occurrences":[{"chapterId":"job-14","v":20,"renderings":{"bsb":"overpower him","kjv":"Thou prevailest"}},{"chapterId":"job-15","v":24,"renderings":{"bsb":"overwhelming him","kjv":"they shall prevail"}},{"chapterId":"ecc-4","v":12,"renderings":{"bsb":"may be overpowered","kjv":"prevail"}}],"elsewhere":[{"ref":"Job 14:20","note":"You forever prevail against him, and he departs. You change his face, and send him away.","source":"web"},{"ref":"Ecclesiastes 4:12","note":"If a man prevails against one who is alone, two shall withstand him; and a threefold cord is not quickly broken.","source":"web"}],"related":[],"sources":["STEPBible TBESH/TBESG lexicon (CC BY 4.0)","STEPBible TAHOT/TAGNT tagged text (CC BY 4.0)"]}