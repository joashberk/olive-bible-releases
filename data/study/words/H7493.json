{"id":"H7493","lemma":"רָעַשׁ","transliteration":"raash","sayIt":"ra-ash","language":"Hebrew","partOfSpeech":"verb","gloss":"to shake","meaning":"1) to quake, shake\n1a) (Qal) to quake, shake\n1b) (Niphal) to be made to quake\n1c)(Hiphil)\n1c1) to cause to quake\n1c2) to cause to spring or leap (of horse)","glosses":["quake","tremble","quaked","quakes","shake","shaken"],"count":30,"occurrences":[{"chapterId":"jdg-5","v":4,"renderings":{"bsb":"trembled","kjv":"trembled"}},{"chapterId":"2sa-22","v":8,"renderings":{"bsb":"and quaked","kjv":"and trembled"}},{"chapterId":"job-39","v":20,"renderings":{"bsb":"Do you make him leap","kjv":"Canst thou make him afraid"}},{"chapterId":"psa-18","v":7,"renderings":{"bsb":"and quaked","kjv":"and trembled"}},{"chapterId":"psa-46","v":3,"renderings":{"bsb":"quake","kjv":"shake"}},{"chapterId":"psa-60","v":2,"renderings":{"bsb":"You have shaken","kjv":"to tremble"}},{"chapterId":"psa-68","v":8,"renderings":{"bsb":"shook","kjv":"shook"}},{"chapterId":"psa-72","v":16,"renderings":{"bsb":"may it sway","kjv":"thereof shall shake"}},{"chapterId":"psa-77","v":18,"renderings":{"bsb":"and quaked"}},{"chapterId":"isa-13","v":13,"renderings":{"bsb":"will be shaken","kjv":"shall remove"}},{"chapterId":"isa-14","v":16,"renderings":{"bsb":"tremble","kjv":"that did shake"}},{"chapterId":"isa-24","v":18,"renderings":{"bsb":"are shaken"}},{"chapterId":"jer-4","v":24,"renderings":{"bsb":"they were quaking","kjv":"they trembled"}},{"chapterId":"jer-8","v":16,"renderings":{"bsb":"quakes","kjv":"trembled"}},{"chapterId":"jer-10","v":10,"renderings":{"bsb":"quakes","kjv":"shall tremble"}},{"chapterId":"jer-49","v":21,"renderings":{"bsb":"will quake","kjv":"is moved"}},{"chapterId":"jer-50","v":46,"renderings":{"bsb":"will quake","kjv":"is moved"}},{"chapterId":"jer-51","v":29,"renderings":{"bsb":"quakes","kjv":"shall tremble"}},{"chapterId":"ezk-26","v":10,"renderings":{"bsb":"will shake","kjv":"shall shake"}},{"chapterId":"ezk-26","v":15,"renderings":{"